{
  "name": "@eeacms/volto-eea-design-system",
  "version": "1.60.8",
  "description": "@eeacms/volto-eea-design-system: Volto add-on",
  "main": "src/index.js",
  "author": "European Environment Agency: IDM2 A-Team",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/eea/volto-eea-design-system",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:eea/volto-eea-design-system.git"
  },
  "addons": [
    "@eeacms/volto-corsproxy"
  ],
  "dependencies": {
    "@eeacms/countup": "*",
    "@eeacms/volto-corsproxy": "*",
    "@fontsource/roboto": "4.5.8",
    "@semantic-ui-react/event-stack": "3.1.3",
    "react-lazy-load-image-component": "1.5.6",
    "react-slick": "^0.30.1",
    "remixicon": "4.6.0",
    "slick-carousel": "^1.8.1"
  },
  "peerDependencies": {
    "@plone/volto": ">=18.0.0 <20.0.0",
    "classnames": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-intl": ">=3.0.0",
    "semantic-ui-react": ">=2.0.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-export-default-from": "7.29.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-throw-expressions": "7.29.7",
    "@babel/plugin-syntax-export-namespace-from": "7.8.3",
    "@cypress/code-coverage": "^3.10.0",
    "@loadable/babel-plugin": "5.16.1",
    "@plone/scripts": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "babel-plugin-lodash": "3.3.4",
    "babel-plugin-react-intl": "5.1.17",
    "babel-plugin-root-import": "6.6.0",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "13.1.0",
    "dotenv": "^16.3.2",
    "eslint-import-resolver-babel-plugin-root-import": "1.1.1",
    "fast-glob": "^3.1.1",
    "husky": "^8.0.3",
    "jsdom": "23.0.0",
    "lint-staged": "^14.0.1",
    "md5": "^2.3.0",
    "postcss-less": "6.0.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@plone/registry": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "redux-mock-store": "1.5.4",
    "redux-thunk": "^2.4.2",
    "release-it": "^19.0.5",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "make lint-fix",
      "make prettier-fix"
    ],
    "src/**/*.{jsx}": [
      "make i18n"
    ],
    "theme/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "src/**/*.{css,less}": [
      "make stylelint-fix"
    ],
    "theme/**/*.overrides": [
      "make stylelint-fix"
    ],
    "src/**/*.overrides": [
      "make stylelint-fix"
    ]
  },
  "scripts": {
    "release": "release-it",
    "release-major-beta": "release-it major --preRelease=beta",
    "release-beta": "release-it --preRelease=beta",
    "test": "vitest --config ./vitest.config.mjs run --passWithNoTests",
    "test:fix": "vitest --config ./vitest.config.mjs run --passWithNoTests --update",
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "prepare": "cd ../.. && husky install || true",
    "dry-release": "release-it --dry-run",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "publishConfig": {
    "access": "public"
  }
}
